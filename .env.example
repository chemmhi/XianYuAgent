# Local development defaults. `npm run dev` loads these values from `.env`.
NODE_ENV=development
DATABASE_URL=postgres://xianyu:xianyu_dev_only@127.0.0.1:5432/xianyu_agent
REDIS_URL=redis://127.0.0.1:6379
ALLOW_IN_MEMORY=false
COOKIE_SECURE=false
XIANYU_QR_MODE=real
# Optional Patchright system-Chrome verification browser: disabled | launch
XIANYU_VERIFICATION_BROWSER_MODE=disabled
# Optional extracted slider solver: disabled | auto
XIANYU_VERIFICATION_SLIDER_MODE=disabled
XIANYU_VERIFICATION_SLIDER_MAX_RETRIES=3
XIANYU_VERIFICATION_BROWSER_HEADLESS=false
# XIANYU_VERIFICATION_BROWSER_EXECUTABLE=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# XIANYU_VERIFICATION_BROWSER_USER_DATA_DIR=
XIANYU_VERIFICATION_BROWSER_MAX_WAIT_MS=180000
# The repaired auto-reply chain is the default development route.
AUTO_REPLY_REPAIR_MODE=enforce
AUTO_REPLY_OUTCOME_REVIEW_WORKER_ENABLED=true
# If an account has no persisted repair policy yet, publish the built-in
# versioned default at API startup. Set false only when policy publication is
# managed separately and AUTO_REPLY_POLICY_JSON is supplied as a compatibility fallback.
AUTO_REPLY_POLICY_BOOTSTRAP_DEFAULT=true
# Optional compatibility fallback for environments that cannot persist policy rows.
# AUTO_REPLY_POLICY_JSON=
# Local development defaults to controlled live sending for the exact buyer below.
# Set the allowlist to an empty JSON array to allow every buyer; keep send mode
# at 'simulate' to disable real sends entirely.
AUTO_REPLY_SEND_MODE=live
AUTOMATION_BUYER_ALLOWLIST=[]
# Product automation external writes are enabled for every buyer when the
# allowlist above is empty. Each product still needs its own automation rule.
PRODUCT_AUTOMATION_EXECUTION_MODE=live
PRODUCT_AUTOMATION_LIVE_CONFIRMED=true
# Product automation and auto-reply share AUTOMATION_BUYER_ALLOWLIST; no product title
# allowlist is required. Use a non-empty JSON array to restrict buyers.
# The one-order live test script additionally requires:
# PRODUCT_AUTOMATION_LIVE_TEST=1
# PRODUCT_AUTOMATION_LIVE_CONFIRM_TEXT=I UNDERSTAND REAL XIANYU MUTATION
# ADMIN_ID=...
# ACCOUNT_ID=...
# ORDER_NO=...
# PRODUCT_AUTOMATION_LIVE_ACTION=payment_paid|unpaid_reprice|review_gift|review_reminder
VITE_API_MODE=live
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_LOGO_VARIANT=agent-fish

# Server-side OpenAI-compatible model settings shared by Workspace and AutoReply.
# Never expose these as VITE_* variables. Settings-page credential resolution is a later slice.
AGENT_RUNTIME=pi
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Use `responses` for providers that expose the OpenAI Responses API.
WIRE_API=responses
MODEL_TIMEOUT_MS=60000
# Set false to keep the existing template generator while Workspace still uses the model.
AUTO_REPLY_MODEL_ENABLED=true
# Buyer Agent runtime settings. These are independent from Workspace Agent settings.
AUTO_REPLY_AGENT_MAX_LOOPS=4
AUTO_REPLY_AGENT_MAX_TOOL_CALLS=8
AUTO_REPLY_AGENT_MAX_TOOL_RESULT_CHARS=12000
AUTO_REPLY_AGENT_TOOL_TIMEOUT_MS=10000
# OpenAI Responses API built-in web_search for general-knowledge fallback.
# Enabled by default; set false to disable it for auto-reply.
AUTO_REPLY_AGENT_WEB_SEARCH_ENABLED=true
AUTO_REPLY_AGENT_MAX_HISTORY=12
AUTO_REPLY_AGENT_MAX_REPLY_LENGTH=500
AUTO_REPLY_AGENT_MAX_REPLY_SEGMENT_CHARS=180
AUTO_REPLY_AGENT_MAX_REPLY_SEGMENTS=4
AUTO_REPLY_AGENT_REPLY_SEGMENT_DELAY_MS=350
AUTO_REPLY_AGENT_DEBOUNCE_MS=2000
# Optional prompt overrides for the buyer-facing Agent.
# AUTO_REPLY_AGENT_SYSTEM_PROMPT=
# AUTO_REPLY_AGENT_USER_PROMPT=
# App-layer AES-256 key material for accounts.credential_values. Replace in every non-dev environment.
CREDENTIAL_ENCRYPTION_KEY=change-me-in-every-environment
