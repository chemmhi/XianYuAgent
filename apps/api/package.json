{
  "name": "xianyu-agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "migrate": "node scripts/migrate.mjs",
    "test:postgres": "npm run build && node scripts/products-postgres-smoke.mjs",
    "test:postgres:credentials": "npm run build && node scripts/credential-store-postgres-smoke.mjs",
    "test:dashboard": "node --import tsx --test scripts/dashboard-service.test.ts",
    "test:dashboard:postgres": "npm run build && node scripts/dashboard-postgres-integration.mjs",
    "test:messages:infra": "npm run build && node scripts/messages-infra-smoke.mjs",
    "test:pi:live": "npm run build && node scripts/pi-runtime-live-smoke.mjs",
    "test:xianyu-im-read": "node --import tsx --test scripts/xianyu-im-read.test.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:orders": "npm run build && node scripts/orders-smoke.mjs",
    "test:orders:postgres": "npm run build && node scripts/orders-postgres-smoke.mjs",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/credential-store-smoke.mjs && node scripts/messages-smoke.mjs && node scripts/onboarding-smoke.mjs && node scripts/workspace-smoke.mjs && node scripts/workspace-ws-smoke.mjs && node scripts/products-smoke.mjs && node scripts/products-sync-smoke.mjs && node scripts/xianyu-product-mapper-smoke.mjs && node scripts/xianyu-order-mapper-smoke.mjs && node scripts/xianyu-cookie-jar-smoke.mjs && node scripts/xianyu-qr-login-smoke.mjs && node scripts/xianyu-order-request-smoke.mjs && node scripts/orders-smoke.mjs && node scripts/pi-runtime-smoke.mjs"
  },
  "dependencies": {
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
