{
  "name": "xianyu-agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "test:postgres": "npm run build && node scripts/products-postgres-smoke.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/onboarding-smoke.mjs && node scripts/products-smoke.mjs"
  },
  "dependencies": {
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
